{
  "name": "forju-compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "test:visitors": "npm --prefix tools/visitor-checks test",
    "test:release": "bash tools/release/run.sh",
    "check:release": "npm run lint && npm test && npm run build && npm run test:visitors",
    "knowledge:import": "node scripts/import-knowledge.mjs",
    "preview:forju": "npm run build && node tools/visitor-checks/preview-forju.mjs",
    "knowledge:refresh": "node tools/knowledge-checks/manage.mjs refresh",
    "knowledge:review": "node tools/knowledge-checks/manage.mjs review",
    "knowledge:check": "node tools/knowledge-checks/manage.mjs check",
    "test:knowledge": "npm --prefix tools/knowledge-checks test",
    "eval:knowledge": "node tools/knowledge-checks/evaluate.mjs after",
    "eval:followups": "COMPASS_EVAL_CASES=tools/knowledge-checks/followup-cases.json node tools/knowledge-checks/evaluate.mjs after work/followup-eval/after.json && COMPASS_EVAL_CASES=tools/knowledge-checks/followup-cases.json node tools/knowledge-checks/evaluate.mjs holdout work/followup-eval/holdout.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "chrono-node": "2.10.3",
    "minisearch": "7.2.0",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "4.10.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
