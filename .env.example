# Existing chatbot services (server only)
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Feedback delivery (server only; never use NEXT_PUBLIC_)
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=adam.maskini@forju.at
FEEDBACK_FROM_EMAIL=

# Optional: ONLY a client-IP header overwritten by your trusted ingress proxy.
# Leave blank locally; unidentified requests share one in-process rate bucket.
FEEDBACK_IP_HEADER=

# Explicit public prototype: fixed account-owner test recipient only.
FEEDBACK_DEMO_MODE=false
# Optional server model override
OPENAI_CHAT_MODEL=
