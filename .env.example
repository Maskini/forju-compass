# Existing chatbot services (server only)
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Feedback delivery (server only; never use NEXT_PUBLIC_)
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=adam.maskini@icloud.com
FEEDBACK_FROM_EMAIL=onboarding@resend.dev

# Optional: ONLY a client-IP header overwritten by your trusted ingress proxy.
# Leave blank locally; unidentified requests share one in-process rate bucket.
FEEDBACK_IP_HEADER=

# The AI mode uses one Responses call with reviewed public evidence.
# Only this model has a reviewed price reservation; an unpriced override fails closed.
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Conservative daily USD reservation, per single-host quota DB. 0 disables paid calls.
# Not an account-wide billing cap; Render's ephemeral disk can reset the ledger.
COMPASS_AI_DAILY_BUDGET_USD=0.25

# Optional embed parents; exact HTTPS origins, separated by commas. Set before build.
COMPASS_EMBED_ORIGINS=https://forju.at,https://www.forju.at
# Absolute path on a persistent local volume for a single Node host.
COMPASS_QUOTA_DB=
# Optional IP header: only if overwritten by your trusted reverse proxy.
COMPASS_CLIENT_IP_HEADER=

# true: zero provider calls. false: AI conversation with reviewed-catalog fallback.
# Keep true until tools/assistant-checks/live.mjs passes with an active API key.
COMPASS_LOCAL_ONLY=true

# Project delivery uses the same FEEDBACK_TO_EMAIL as feedback.
# Leave blank to reuse FEEDBACK_FROM_EMAIL. The sandbox sender supports only the account-owner iCloud inbox.
# For delivery to adam.maskini@forju.at later, configure a verified domain sender for both forms.
PROJECT_FROM_EMAIL=
