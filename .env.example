# Existing chatbot services (server only)
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Feedback delivery (server only; never use NEXT_PUBLIC_)
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Optional: only use a client-IP header that is reliably overwritten
# by your trusted ingress proxy.
FEEDBACK_IP_HEADER=

# Optional server model override
OPENAI_CHAT_MODEL=
